TMDB_API_READ_ACCESS_TOKEN=
# Optional: override for a self-hosted Kuryana instance. Defaults to https://kuryana.tbdh.app.
KURYANA_BASE_URL=
# Set to false to disable Asian-drama search without affecting TMDB.
KURYANA_ENABLED=true
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login

# Account storage (Neon Postgres; run npm run db:migrate:tracker)
# Production and trusted previews must use the same DB and Clerk instance for shared accounts.
DATABASE_URL=
# Prefer the direct URL for migrations.
DATABASE_URL_UNPOOLED=

# Background Web Push (same database; run npm run db:migrate:push)
# Generate a stable pair with npm run push:keys. Keep the private key server-only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Random secret used by the scheduler's Authorization: Bearer header
CRON_SECRET=

# Canonical site origin (HTTPS in production, no path); required for sitemap URLs.
NEXT_PUBLIC_APP_URL=

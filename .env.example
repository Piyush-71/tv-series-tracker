TMDB_API_READ_ACCESS_TOKEN=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login

# Background Web Push (Neon Postgres; run npm run db:migrate:push)
DATABASE_URL=
# Generate a stable pair with npm run push:keys. Keep the private key server-only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Random secret used by the scheduler's Authorization: Bearer header
CRON_SECRET=

# Canonical site origin (HTTPS in production, no path); required for sitemap URLs.
NEXT_PUBLIC_APP_URL=
